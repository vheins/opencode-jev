# TypeSafe Jev integration for opencode, routed through the router provider.
# Copy to .env (or export in your shell) before starting opencode.
# Both JEV_API_KEY and JEV_BASE_URL are required to enable the guardrails; if
# either is unset the plugin degrades to a no-op that warns once.

# Bearer key for the router provider.
# When unset, the plugin falls back to ~/.config/opencode/.jev-key,
# then no-ops with a warning if neither source yields a key.
JEV_API_KEY=

# Router pass-through route for System One judgments. REQUIRED: the plugin
# ships no default host, so leaving this blank disables Jev (no-op + warn).
# Set it to your own router provider's System One endpoint, for example:
#   JEV_BASE_URL=https://your-router.example/v1/systemone
JEV_BASE_URL=

# Jev model id.
JEV_MODEL=oc/jev-1.13-free

# Block destructive tool calls when Jev confidence exceeds this value.
JEV_BLOCK_THRESHOLD=0.85

# Surface a toast when a chat.message cascade route resolves to needs_human at
# or above this confidence (optional).
JEV_ROUTE_THRESHOLD=0.8

# Surface a toast when a session.error severity resolves to real_bug/fatal at or
# above this confidence (optional).
JEV_SEVERITY_THRESHOLD=0.8

# Append a preservation reminder to the compaction context when the session is
# judged to hold unrecoverable decisions at or above this probability (optional).
JEV_COMPACT_THRESHOLD=0.75

# Surface a review toast when an edited file is judged security-sensitive at or
# above this probability (optional).
JEV_FILE_REVIEW_THRESHOLD=0.8
